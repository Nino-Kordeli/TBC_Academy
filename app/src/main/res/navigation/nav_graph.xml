<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/logInFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.challenge.presentation.screen.splash.SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_logInFragment"
            app:destination="@id/logInFragment" />
        <action
            android:id="@+id/action_splashFragment_to_connectionsFragment"
            app:destination="@id/connectionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/logInFragment"
        android:name="com.example.challenge.presentation.screen.log_in.LogInFragment"
        tools:layout="@layout/fragment_log_in">
        <action
            android:id="@+id/action_logInFragment_to_connectionsFragment"
            app:destination="@id/connectionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/connectionsFragment"
        android:name="com.example.challenge.presentation.screen.connection.ConnectionsFragment"
        tools:layout="@layout/fragment_connections">
        <action
            android:id="@+id/action_connectionsFragment_to_logInFragment"
            app:destination="@id/logInFragment" />
    </fragment>

</navigation>