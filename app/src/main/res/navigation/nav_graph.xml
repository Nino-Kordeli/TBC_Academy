<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/userDashboardFragment">

    <fragment
        android:id="@+id/userDashboardFragment"
        android:name="com.example.tbcacademy.screens.UserDashboardFragment"
        android:label="fragment_user_dashboard"
        tools:layout="@layout/fragment_user_dashboard">
        <action
            android:id="@+id/action_userDashboardFragment_to_userFormFragment"
            app:destination="@id/userFormFragment" />
    </fragment>
    <fragment
        android:id="@+id/userFormFragment"
        android:name="com.example.tbcacademy.screens.UserFormFragment"
        android:label="fragment_user_form"
        tools:layout="@layout/fragment_user_form">

        <argument
            android:name="operationType"
            app:argType="com.example.tbcacademy.model.OperationType" />

        <argument
            android:name="user"
            app:argType="com.example.tbcacademy.model.User"
            app:nullable="true" />

        <action
            android:id="@+id/action_userFormFragment_to_userDashboardFragment"
            app:destination="@id/userDashboardFragment" />
    </fragment>
</navigation>