<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddUserActivity">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etFirstnameField"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="30dp"
        android:background="@color/white"
        android:hint="@string/firstname"
        android:inputType="text"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etLastnameField"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="30dp"
        android:background="@color/white"
        android:hint="@string/lastname"
        android:inputType="text"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/etFirstnameField" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etBirthdayField"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="30dp"
        android:background="@color/white"
        android:hint="@string/birthday"
        android:inputType="text"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/etLastnameField" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etAddressField"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="30dp"
        android:background="@color/white"
        android:hint="@string/address"
        android:inputType="text"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/etBirthdayField" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etEmailField"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="30dp"
        android:background="@color/white"
        android:hint="@string/email"
        android:inputType="text"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/etAddressField" />

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="110dp"
        android:background="@color/white"
        android:text="@string/add_user"
        android:textAllCaps="false"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/etEmailField" />


</androidx.constraintlayout.widget.ConstraintLayout>