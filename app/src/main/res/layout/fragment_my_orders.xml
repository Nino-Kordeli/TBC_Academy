<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".screen.my_orders.MyOrdersFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iconMore"
        android:layout_width="18dp"
        android:layout_height="17dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="67.5dp"
        android:src="@drawable/ic_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/product_sans_medium"
        android:layout_marginTop="63dp"
        android:text="@string/my_orders"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="63dp"
        android:layout_marginEnd="31dp"
        android:src="@drawable/ic_bell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPending"
        android:layout_width="90dp"
        android:fontFamily="@font/product_sans_medium"
        android:layout_height="28dp"
        android:layout_marginStart="33dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/button_default_design"
        android:text="@string/pending"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconMore" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDelivered"
        android:layout_width="90dp"
        android:layout_height="28dp"
        android:layout_marginStart="18dp"
        android:fontFamily="@font/product_sans_medium"
        android:background="@drawable/button_default_design"
        android:text="@string/delivered"
        android:textAllCaps="false"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/btnPending"
        app:layout_constraintEnd_toStartOf="@id/btnCanceled"
        app:layout_constraintStart_toEndOf="@id/btnPending"
        app:layout_constraintTop_toTopOf="@id/btnPending" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCanceled"
        android:layout_width="90dp"
        android:layout_height="28dp"
        android:fontFamily="@font/product_sans_medium"
        android:layout_marginStart="18dp"
        android:background="@drawable/button_default_design"
        android:text="@string/cancelled"
        android:textAllCaps="false"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/btnDelivered"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnDelivered"
        app:layout_constraintTop_toTopOf="@id/btnDelivered" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnDelivered"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>