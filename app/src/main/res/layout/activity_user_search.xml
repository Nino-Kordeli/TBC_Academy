<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UserSearchActivity">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etSearchField"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="35dp"
        android:background="@color/white"
        android:hint="@string/search"
        android:inputType="text"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:gravity="center"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/etSearchField"
        app:layout_constraintStart_toStartOf="@id/etSearchField"
        app:layout_constraintTop_toBottomOf="@id/etSearchField"
        tools:text="User not found" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddNewUser"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="110dp"
        android:layout_marginBottom="60dp"
        android:background="@color/white"
        android:text="@string/add_new_user"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>