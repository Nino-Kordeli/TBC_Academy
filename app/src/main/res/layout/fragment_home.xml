<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F4F4"
    tools:context=".presentation.home.fragment.HomeFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivUserIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="25dp"
        android:src="@drawable/outline_comedy_mask_24"
        android:padding="8dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFavorites"
        android:layout_width="53dp"
        android:layout_height="33dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_saved_recipes_btn"
        android:drawableStart="@drawable/ic_bookmark"
        android:paddingStart="7dp"
        android:paddingEnd="10dp"
        android:text="@string/_2"
        android:textColor="@color/green"
        app:layout_constraintBottom_toBottomOf="@id/ivUserIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivUserIcon" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBannerPhoto"
        android:layout_width="match_parent"
        android:layout_height="185dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_rounded_corners"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/banner_image"
        app:layout_constraintTop_toBottomOf="@id/ivUserIcon"
        tools:targetApi="31" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="40dp"
        android:text="@string/cook_master"
        android:background="@drawable/bg_rounded_corners"
        android:backgroundTint="#95BF7C"
        android:padding="10dp"
        android:textColor="@color/white"
        android:textFontWeight="800"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="@id/ivBannerPhoto"
        app:layout_constraintTop_toTopOf="@id/ivBannerPhoto" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvRecipeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:text="@string/trending_recipes"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBannerPhoto" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrendingRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvRecipeTitle"
        tools:listitem="@layout/recipe_item" />

</androidx.constraintlayout.widget.ConstraintLayout>