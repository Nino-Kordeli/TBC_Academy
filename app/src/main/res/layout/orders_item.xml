<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="9.5dp"
    android:paddingTop="8dp"
    android:paddingEnd="9.5dp"
    android:paddingBottom="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/orderItem"
        android:layout_width="match_parent"
        android:layout_height="182dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrderIdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="18dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_regular"
        android:text="@string/order"
        android:textColor="@color/black"
        android:textFontWeight="700"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/orderItem"
        app:layout_constraintTop_toTopOf="@id/orderItem" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_regular"
        android:textColor="@color/black"
        android:textFontWeight="700"
        app:layout_constraintBottom_toBottomOf="@id/tvOrderIdText"
        app:layout_constraintStart_toEndOf="@id/tvOrderIdText"
        app:layout_constraintTop_toTopOf="@id/tvOrderIdText"
        tools:text="#498735389" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="12dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_medium"
        android:textColor="@color/grey"
        android:textFontWeight="500"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/orderItem"
        app:layout_constraintTop_toTopOf="@id/orderItem"
        tools:text="13/05/2021" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTrackingNumberText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_medium"
        android:text="@string/tracking_number"
        android:textColor="@color/grey"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tvOrderIdText"
        app:layout_constraintTop_toBottomOf="@id/tvOrderIdText" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTrackingNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_medium"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tvTrackingNumberText"
        app:layout_constraintStart_toEndOf="@id/tvTrackingNumberText"
        app:layout_constraintTop_toTopOf="@id/tvTrackingNumberText"
        tools:text="IK287368838" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuantityText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_medium"
        android:text="@string/quantity"
        android:textColor="@color/grey"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tvTrackingNumberText"
        app:layout_constraintTop_toBottomOf="@id/tvTrackingNumberText" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvquantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_medium"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tvQuantityText"
        app:layout_constraintStart_toEndOf="@id/tvQuantityText"
        app:layout_constraintTop_toTopOf="@id/tvQuantityText"
        tools:text="2" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="22dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_medium"
        android:textColor="@color/orange"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/orderItem"
        app:layout_constraintStart_toStartOf="@id/tvQuantityText"
        app:layout_constraintTop_toBottomOf="@id/tvQuantityText"
        tools:text="PENDING" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="57dp"
        android:layout_marginEnd="20dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_medium"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/orderItem"
        app:layout_constraintTop_toBottomOf="@id/tvDate"
        tools:text="$110" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:elevation="2dp"
        android:fontFamily="@font/product_sans_medium"
        android:text="@string/subtotal"
        android:textColor="@color/grey"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tvPrice"
        app:layout_constraintEnd_toStartOf="@id/tvPrice"
        app:layout_constraintTop_toTopOf="@id/tvPrice" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDetails"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/button_design"
        android:fontFamily="@font/product_sans_medium"
        android:text="@string/details"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@id/tvStatusText"
        app:layout_constraintEnd_toEndOf="@id/orderItem"
        app:layout_constraintTop_toTopOf="@id/tvStatusText" />


</androidx.constraintlayout.widget.ConstraintLayout>