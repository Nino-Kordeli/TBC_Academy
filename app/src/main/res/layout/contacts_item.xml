<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginBottom="7dp"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivContactBackground"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/circle_design"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvContactName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvTimeSent"
        app:layout_constraintStart_toEndOf="@id/ivContactBackground"
        app:layout_constraintTop_toTopOf="@id/ivContactBackground"
        tools:text="Alice Smith" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTimeSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvContactName"
        tools:text="4:20" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/ivMessageType"
        app:layout_constraintStart_toStartOf="@id/tvContactName"
        app:layout_constraintTop_toBottomOf="@id/tvContactName"
        tools:text="Great. I will have a look" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivMessageType"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTimeSent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvUnreadCount"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/circle_design"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/ivMessageType"
        app:layout_constraintTop_toBottomOf="@id/ivMessageType" />

    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#B8C2C0"
        app:layout_constraintStart_toStartOf="@id/tvLastMessage"
        app:layout_constraintTop_toBottomOf="@id/ivContactBackground" />

</androidx.constraintlayout.widget.ConstraintLayout>