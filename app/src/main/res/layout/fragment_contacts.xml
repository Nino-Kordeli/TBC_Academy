<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#22343C"
    tools:context=".presentation.screens.contacts.ContactsFragment">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etSearchField"
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:textColor="@color/white"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/search_design"
        android:drawableStart="@drawable/search_icon"
        android:drawablePadding="10dp"
        android:hint="@string/search"
        android:paddingStart="24dp"
        android:paddingEnd="0dp"
        android:textColorHint="#96A7AF"
        app:layout_constraintEnd_toStartOf="@id/btnFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnFilter"
        android:layout_width="63dp"
        android:layout_height="60dp"
        android:layout_marginEnd="28dp"
        android:adjustViewBounds="true"
        android:background="@drawable/filter_design"
        android:padding="21dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/etSearchField"
        app:layout_constraintTop_toTopOf="@id/etSearchField" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/etSearchField" />

</androidx.constraintlayout.widget.ConstraintLayout>