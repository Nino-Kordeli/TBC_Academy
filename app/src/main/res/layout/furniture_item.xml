<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="9.5dp"
    android:paddingTop="8dp"
    android:paddingEnd="9.5dp"
    android:paddingBottom="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBackground"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginHorizontal="10dp"
        android:backgroundTint="#1f222b"
        app:cardCornerRadius="30dp"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCardItemBackground"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/rounded_corners"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@id/cardBackground"
        app:layout_constraintStart_toStartOf="@id/cardBackground"
        app:layout_constraintTop_toTopOf="@id/cardBackground" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvItemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:elevation="2dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/ivCardItemBackground"
        app:layout_constraintTop_toTopOf="@id/ivCardItemBackground"
        tools:text="Modern Wingback" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivColor"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="7dp"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="@id/tvItemTitle"
        app:layout_constraintTop_toBottomOf="@id/tvItemTitle"
        tools:background="@drawable/color_black" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvColorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:elevation="2dp"
        android:textColor="#b9babd"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/ivColor"
        app:layout_constraintStart_toEndOf="@id/ivColor"
        app:layout_constraintTop_toTopOf="@id/ivColor"
        tools:text="Black" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:elevation="2dp"
        android:text="@string/separator"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/tvColorText"
        app:layout_constraintStart_toEndOf="@id/tvColorText"
        app:layout_constraintTop_toTopOf="@id/tvColorText" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuantityText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:elevation="2dp"
        android:text="@string/qty"
        android:textColor="#b9babd"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/tvSeparator"
        app:layout_constraintStart_toEndOf="@id/tvSeparator"
        app:layout_constraintTop_toTopOf="@id/tvSeparator" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:elevation="2dp"
        android:textColor="#b9babd"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/tvQuantityText"
        app:layout_constraintStart_toEndOf="@id/tvQuantityText"
        app:layout_constraintTop_toTopOf="@id/tvQuantityText"
        tools:text="2" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvStatus"
        android:layout_width="65dp"
        android:layout_height="23dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/status_background"
        android:elevation="2dp"
        android:gravity="center"
        android:text="@string/completed"
        android:textColor="@color/white"
        android:textSize="9sp"
        app:layout_constraintStart_toStartOf="@id/ivColor"
        app:layout_constraintTop_toBottomOf="@id/ivColor" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:elevation="2dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@id/tvStatus"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        tools:text="$280.00" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnReview"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:elevation="2dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:textSize="12sp"
        android:background="@drawable/button_design"
        app:layout_constraintBottom_toBottomOf="@id/tvPrice"
        app:layout_constraintEnd_toEndOf="@id/cardBackground"
        app:layout_constraintStart_toEndOf="@id/tvPrice"
        app:layout_constraintTop_toTopOf="@id/tvPrice"
        tools:text="Leave Review" />

</androidx.constraintlayout.widget.ConstraintLayout>