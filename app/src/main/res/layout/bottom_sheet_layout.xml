<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottomsheet_background">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLeaveAReviewText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/leave_a_review"
        android:textColor="@color/white"
        android:textSize="23sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="25dp"
        android:background="@color/grey"
        app:layout_constraintTop_toBottomOf="@id/tvLeaveAReviewText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSingleItem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/topSeparator" />

    <View
        android:id="@+id/middleSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="25dp"
        android:background="@color/grey"
        app:layout_constraintTop_toBottomOf="@id/rvSingleItem" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvHowIsOrderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="-0.04"
        android:text="@string/how_is_your_order"
        android:textColor="@color/white"
        android:textSize="29sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/middleSeparator" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvGiveRatingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="-0.04"
        android:text="@string/please_give_your_rating_also_your_review"
        android:textColor="@color/lighter_grey"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHowIsOrderText" />

    <RatingBar
        android:id="@+id/starRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="70dp"
        android:layout_marginTop="21dp"
        android:numStars="5"
        android:stepSize="1"
        app:layout_constraintTop_toBottomOf="@id/tvGiveRatingText" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etReviewField"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/review_field_design"
        android:hint="@string/write_your_review"
        android:paddingStart="20dp"
        android:paddingEnd="40dp"
        android:textColor="@color/lighter_grey"
        android:textColorHint="@color/lighter_grey"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/starRating"
        tools:text="Very good product" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/ic_attach_image"
        app:layout_constraintBottom_toBottomOf="@id/etReviewField"
        app:layout_constraintEnd_toEndOf="@id/etReviewField"
        app:layout_constraintTop_toTopOf="@id/etReviewField" />

    <View
        android:id="@+id/bottomSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="25dp"
        android:background="@color/grey"
        app:layout_constraintTop_toBottomOf="@id/etReviewField" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/review_button_design"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnSubmit"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottomSeparator" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmit"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/review_button_design"
        android:backgroundTint="@color/creamy_white"
        android:text="@string/submit"
        android:textAllCaps="false"
        android:textColor="@color/dark_grey"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btnCancel"
        app:layout_constraintTop_toBottomOf="@id/bottomSeparator" />
</androidx.constraintlayout.widget.ConstraintLayout>