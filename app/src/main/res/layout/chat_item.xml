<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/chatBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-8dp"
        android:background="@drawable/chat_background"
        android:maxWidth="250dp"
        android:padding="18dp"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/triangle"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Hello my name" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/triangle"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chat_triangle"
        app:layout_constraintBottom_toBottomOf="@id/chatBox"
        app:layout_constraintStart_toStartOf="parent" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="@color/grey"
        app:layout_constraintStart_toEndOf="@id/triangle"
        app:layout_constraintTop_toBottomOf="@id/chatBox"
        tools:text="10:30 AM" />

</androidx.constraintlayout.widget.ConstraintLayout>